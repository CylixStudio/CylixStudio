# Public (browser) — also accepted without VITE_ prefix via vite.config mapping
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Server (API / SSR) — required for OAuth + server functions (Auth Admin createUser).
# SUPABASE_URL must be the same project as the service key below.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
# Privileged key for Auth Admin / RLS bypass — NEVER use the publishable/anon key here.
# Dashboard → Settings → API Keys (same project as SUPABASE_URL above):
#   - Legacy: copy "service_role" (JWT starting with eyJ…, role service_role)
#   - New keys: copy "secret" (sb_secret_…) OR keep using legacy service_role JWT
# A key from a different project causes AuthApiError: Unregistered API key (401) on Kick/Twitch OAuth.
# Alias also accepted: SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key
# SUPABASE_SECRET_KEY=

# Database password (Dashboard → Project Settings → Database) — required to apply migrations:
#   node scripts/apply-pending-migrations.mjs
# SUPABASE_DB_PASSWORD=
# Optional override if the pooler region is not eu-central-1:
# SUPABASE_DB_REGION=aws-0-eu-central-1
# Or paste a full URI instead:
# DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# HMAC for Settings → "Connect" account-link state (recommended dedicated secret).
# Falls back to SUPABASE_SERVICE_ROLE_KEY. Never leave both empty.
# OAUTH_LINK_SECRET=

# HMAC for public mark-share gate cookies (optional; falls back to OAUTH_LINK_SECRET / service role).
# MARK_SHARE_GATE_SECRET=

# Optional aliases (same values as publishable/anon key)
# SUPABASE_ANON_KEY=
# VITE_SUPABASE_ANON_KEY=

# Site origin for OAuth redirect_uri / EventSub / clip links (no trailing slash).
# Local: use localhost so cookies and OAuth state stay on the same host.
# Production (Vercel): set https://www.cylixstudio.com — Vercel 308-redirects apex → www.
# Do NOT paste the production www URL into a local .env (request-host overrides still
# prefer localhost when the request is local, but cookies can mismatch).
PUBLIC_SITE_URL=http://localhost:3000
# PUBLIC_SITE_URL=https://www.cylixstudio.com

# ─── Kick OAuth + webhooks ───────────────────────────────────────────────────
# Authorize ONLY on id.kick.com — never api.kick.com/oauth.
# Register this Redirect URI in the Kick developer console EXACTLY:
#   https://www.cylixstudio.com/api/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Optional space-separated override if the Kick app only enables a subset of scopes:
# KICK_OAUTH_SCOPES=user:read channel:read chat:write events:subscribe
# Webhook verification (RSA public key PEM, or shared HMAC secret for relays).
# Timestamps outside ±10 minutes are rejected (replay protection).
# KICK_WEBHOOK_PUBLIC_KEY=
# KICK_WEBHOOK_SECRET=

# ─── Twitch OAuth + EventSub ────────────────────────────────────────────────
# Register this Redirect URI in the Twitch console EXACTLY:
#   https://www.cylixstudio.com/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Required for EventSub webhook verification (10–100 chars). Auto-subscribed on Twitch connect.
# Callback URL: https://www.cylixstudio.com/api/public/webhooks/twitch
TWITCH_EVENTSUB_SECRET=

# ─── StreamElements (tips via webhook JWT) ───────────────────────────────────
# OAuth app credentials (optional — users can also paste a JWT in Settings).
# STREAMELEMENTS_CLIENT_ID=
# STREAMELEMENTS_CLIENT_SECRET=
# Webhook path: /api/public/webhooks/streamelements (Authorization: Bearer <channel JWT>)

# ─── Streamlabs (tips via alert webhook) ─────────────────────────────────────
# OAuth app credentials (optional — socket token can be pasted in Settings).
# STREAMLABS_CLIENT_ID=
# STREAMLABS_CLIENT_SECRET=
# Optional shared secret required on every webhook (header x-streamlabs-secret or ?secret=).
# STREAMLABS_WEBHOOK_SECRET=
# Webhook path: /api/public/webhooks/streamlabs
# Prefer Authorization: Bearer <connection token> (query ?token= still accepted for legacy URLs).

# ─── TikTok Login Kit (Coming Soon — leave empty until enabled) ──────────────
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# ─── YouTube Data API (media request metadata; falls back to oEmbed) ─────────
# YOUTUBE_API_KEY=

# ─── X / Twitter (Live Counter follower totals) ──────────────────────────────
# X_BEARER_TOKEN=

# ─── Pro checkout → activation code delivery ─────────────────────────────────
# After a successful Pro payment, POST to:
#   /api/public/webhooks/pro-checkout
# with Authorization: Bearer <PRO_CHECKOUT_WEBHOOK_SECRET>
# Body:
#   {
#     email, payment_id, interval: monthly|six_months|yearly,
#     purchase_type?: "direct" | "gift",   # default gift
#     user_id?,                            # required when purchase_type=direct
#     gift_recipient_email?, gift_message?, buyer_name?,
#     provider?, phone?, locale?: ar|en
#   }
# direct → activates Pro on user_id immediately (confirmation email, no code)
# gift   → generates code + emails gift/activation template to recipient or buyer
# PRO_CHECKOUT_WEBHOOK_SECRET=  # min 16 chars
#
# Resend (verified domain cylixstudio.com):
# RESEND_API_KEY=
# EMAIL_FROM=CylixStudio <noreply@cylixstudio.com>
#
# Optional SMS (Twilio) when webhook includes "phone":
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
